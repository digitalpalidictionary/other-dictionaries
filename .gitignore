# Build outputs
build/
*.zip

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
dist/

# IDE
.vscode/
.idea/

# Generated files
bulk_dump_html.html
*.js.map

# Source - ignore source dirs but track compressed archives
/dictionaries/*/source/
!/dictionaries/*/*.tar.zst

# MW: track the raw Cologne zip as download cache + offline fallback
!/dictionaries/mw/source/
/dictionaries/mw/source/*
!/dictionaries/mw/source/mwweb1.zip

# Apte: same deal — Cologne is a third party, and prepare_sources.py only
# re-downloads when the remote size changes, so this costs history space
# solely on a genuine upstream update.
!/dictionaries/apte/source/
/dictionaries/apte/source/*
!/dictionaries/apte/source/ap90web1.zip

# logs
*.log
archive/*

# CPD scraper
scrapers/cpd/data/
scrapers/cpd/diagnose_report.txt
scrapers/cpd/.python-version

# Cone scraper
scrapers/cone/headwords.tsv
scrapers/cone/cone_dict.json
scrapers/cone/front_matter.json
scrapers/cone/test.html
scrapers/cone/.python-version
